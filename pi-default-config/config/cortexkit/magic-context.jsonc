{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "historian": {
    "opencode": {
      "model": "aiproxy/opencode-go/mimo-v2.5"
    },
    "pi": {
      "model": "aiproxy/opencode-go/mimo-v2.5"
    }
  },
  "dreamer": {
    "opencode": {
      "model": "aiproxy/opencode-go/mimo-v2.5"
    },
    "pi": {
      "model": "aiproxy/opencode-go/mimo-v2.5"
    }
  },
  "sidekick": {
    "model": "aiproxy/opencode-go/mimo-v2.5"
  },
  "embedding": {
    "provider": "openai-compatible",
    "model": "embeddings-local/all-MiniLM-L6-v2",
    "endpoint": "http://host.containers.internal:9999/v1",
    "api_key": "AIPROXY_TOKEN"
  },
  "execute_threshold_percentage": {
    "default": 65,
    "aiproxy/opencode-go/mimo-v2.5": 25,
    "aiproxy/opencode-go/deepseek-v4-flash": 25
  }
}
