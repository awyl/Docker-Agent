{
  "$schema": "https://raw.githubusercontent.com/cortexkit/aft/master/assets/aft.schema.json",
  "semantic": {
    "backend": "openai_compatible",
    "model": "embeddings-local/all-MiniLM-L6-v2",
    "base_url": "http://host.containers.internal:9999/v1",
    "api_key_env": "AIPROXY_TOKEN"
  },
  // Container is the sandbox; don't prompt for reads outside /work
  // (skills/plugins live in ~/.pi). Credentials + read_deny still refused.
  "pi": {
    "external_access_ask": false
  },
  "lsp": {
    "disabled": [
      "rust",
      "python"
    ]
  }
}
