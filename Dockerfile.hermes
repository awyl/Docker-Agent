# syntax=docker/dockerfile:1
#
# Hermes agent (NousResearch) runner, built on the agentic-dev-base.
# Build the base first:   docker build -t agentic-dev-base:latest .
#
# Codebase + Hermes config are bind-mounted at RUN time (not baked in):
#   - host repo      -> /work
#   - host ~/.hermes -> /home/dev/.hermes  (also XDG data/config, see below)
#
# UID/GID are build args so files written into the mounted config/repo
# stay owned by your host user.

# Re-based on the browser layer (labwc + Camoufox) so the hermes agent can drive
# a stealth browser. UID/GID are consumed by that layer (which creates the `dev`
# user); declared here so build.sh can pass them without an "unused build arg"
# warning. For the watchable view, boot this image with run-browser.sh.
FROM agentic-browser-base:latest

ARG UID=1000
ARG GID=1000

# Hermes pin: clone tag/branch to install. Defaults to the default branch.
ARG HERMES_REF=main

# Hermes is a Python app. Install it into an isolated venv at /opt/hermes and
# symlink the launcher onto the global PATH. Kept OUT of ~/.hermes on purpose:
# that dir is the runtime-mounted config and would shadow anything installed
# there. uv (from the base) fetches Python 3.11 — the `.[all]` voice deps are
# not yet 3.13-clean. ffmpeg is needed for the voice/TTS toolset.
#
# UV_PYTHON_INSTALL_DIR puts the managed interpreter under /opt (world-
# traversable) instead of the default /root/.local/share (mode 700), so the
# non-root `dev` user can actually exec the venv's python at runtime.
#
# The install is EDITABLE (-e). Upstream's build backend refuses to produce a
# wheel or sdist ("Hermes is distributed via the shell installer, Docker image,
# or Nix") and points developers at an editable install instead. That is safe
# here: /opt/hermes is a git clone baked into the image, not a runtime mount, so
# the tree the .pth points at is always present and read-only in practice.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ffmpeg; \
    rm -rf /var/lib/apt/lists/*; \
    git clone --depth 1 --branch "${HERMES_REF}" \
        https://github.com/NousResearch/hermes-agent.git /opt/hermes; \
    uv venv /opt/hermes/.venv --python 3.11; \
    VIRTUAL_ENV=/opt/hermes/.venv uv pip install --no-cache -e "/opt/hermes[all]"; \
    ln -s /opt/hermes/.venv/bin/hermes /usr/local/bin/hermes; \
    chmod -R a+rX /opt/uv/python /opt/hermes; \
    rm -rf /root/.cache /tmp/*; \
    test -x /usr/local/bin/hermes

# The non-root `dev` user (UID/GID-matched) is created by the browser base layer.

USER dev
ENV HOME=/home/dev

# Redirect XDG data + config under the bind-mounted Hermes config dir so plugins
# that store state in $XDG_DATA_HOME (default ~/.local/share) or read config from
# $XDG_CONFIG_HOME (default ~/.config) — both ephemeral here, only ~/.hermes is
# mounted — persist across containers. XDG_CACHE_HOME and XDG_RUNTIME_DIR are
# left alone: the browser base layer sets those for Camoufox and the compositor.
ENV XDG_DATA_HOME=/home/dev/.hermes/share
ENV XDG_CONFIG_HOME=/home/dev/.hermes/config

WORKDIR /work

# Bare `hermes` starts the interactive CLI; extra args from `docker run` are
# appended. The browser view uses a different entrypoint (`with-view`), which
# run-browser.sh selects explicitly.
ENTRYPOINT ["hermes"]
