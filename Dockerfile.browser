# syntax=docker/dockerfile:1
#
# Reusable browser layer: agentic-dev-base + a Wayland remote view (labwc +
# wayvnc + noVNC) + Camoufox (stealth Firefox, driven by Playwright). Sits
# BETWEEN the base and the agent images so any agent can be re-based onto it to
# drive & remotely watch a browser. Build order:
#   docker build -t agentic-dev-base:latest .
#   docker build -f Dockerfile.browser \
#     --build-arg UID="$(id -u)" --build-arg GID="$(id -g)" \
#     -t agentic-browser-base:latest .
#
# Remote view: the `with-view` entrypoint execs labwc as PID1; labwc's autostart
# brings up wayvnc and websockify (serving noVNC). Camoufox runs non-headless on
# that compositor, so you watch the exact browser the agent controls. No TLS and
# no password — run-browser.sh publishes the port to 127.0.0.1 only.
FROM agentic-dev-base:latest

ARG UID=1000
ARG GID=1000

ENV DEBIAN_FRONTEND=noninteractive

# --- Wayland view stack + Firefox/Camoufox runtime libs, one layer ---
# Everything here is Debian trixie main: no third-party repo, no compilation.
#   labwc      wlroots compositor, runs headless (WLR_BACKENDS=headless)
#   wayvnc     RFB server that attaches to labwc via wlr-screencopy
#   novnc      browser client, served as static files from /usr/share/novnc
#   websockify serves those files and proxies WebSocket -> wayvnc's TCP port
# t64 suffixes (libasound2t64, libgtk-3-0t64) are the Debian trixie time64 names.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        labwc wayvnc novnc websockify wlr-randr wl-clipboard \
        dbus \
        libgl1-mesa-dri \
        libgtk-3-0t64 libx11-xcb1 libasound2t64 libdbus-glib-1-2 \
        libgdk-pixbuf-2.0-0 libpangocairo-1.0-0 libxcomposite1 libxdamage1 \
        libxfixes3 libxrandr2 libxkbcommon0 libatk1.0-0t64 libatk-bridge2.0-0t64 \
        libcups2t64 libnss3 libxss1 \
        fonts-liberation fonts-noto-core; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /usr/share/doc/* /usr/share/man/* /tmp/*; \
    command -v labwc; command -v wayvnc; command -v websockify; \
    test -f /usr/share/novnc/vnc.html

# --- Camoufox in its own venv, launcher symlinked onto PATH ---
# uv (from the base) fetches Python 3.11. Kept out of any runtime-mounted dir.
# Playwright is pinned: camoufox 0.4.11's bundled Firefox speaks an older Juggler
# protocol, and playwright > 1.55 sends a setDefaultViewport shape (isMobile) it
# rejects. 1.55.0 is the newest confirmed-compatible release.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
RUN set -eux; \
    uv venv /opt/camoufox/.venv --python 3.11; \
    VIRTUAL_ENV=/opt/camoufox/.venv uv pip install --no-cache "camoufox[geoip]" "playwright==1.55.0"; \
    ln -s /opt/camoufox/.venv/bin/camoufox /usr/local/bin/camoufox; \
    chmod -R a+rX /opt/uv/python /opt/camoufox; \
    rm -rf /root/.cache /tmp/*

# Non-root user (UID/GID match the host owner of mounted files). Created HERE so
# every agent re-based on this layer inherits it — agent Dockerfiles no longer
# create their own.
RUN set -eux; \
    groupadd -g "${GID}" dev 2>/dev/null || true; \
    useradd -m -u "${UID}" -g "${GID}" -s /bin/bash dev

# Download the Camoufox browser + GeoIP DB, baked into the image. Run as root
# (the GeoIP mmdb writes into the root-owned venv site-packages) but with HOME
# set to dev's home so the ~700MB browser lands in /home/dev/.cache/camoufox;
# then hand that cache to dev so the runtime user can read it.
RUN HOME=/home/dev camoufox fetch
RUN chown -R "${UID}:${GID}" /home/dev/.cache

# Rootless Docker runs the container as root (`--user 0:0`) so bind mounts stay
# writable, but Firefox aborts as root when $HOME is owned by someone else. The
# camoufox-py wrapper handles that by switching root to HOME=/root with
# XDG_CACHE_HOME pointed back at the cache above.

# Helper scripts last, so tweaking them doesn't invalidate the ~700MB camoufox
# fetch layer above. with-view (entrypoint), camoufox-open (launcher),
# camoufox-py (venv python), plus the labwc config that autostart depends on.
COPY browser/with-view browser/camoufox-open browser/camoufox-py /usr/local/bin/
COPY browser/labwc-rc.xml /etc/labwc/rc.xml
COPY browser/labwc-autostart /etc/labwc/autostart
RUN chmod 0755 /usr/local/bin/with-view /usr/local/bin/camoufox-open \
      /usr/local/bin/camoufox-py /etc/labwc/autostart

# Stays root so child agent images can install their own packages. Every shell —
# including `docker exec`, which does not inherit the entrypoint's environment —
# needs to find the compositor. XDG_RUNTIME_DIR is a fixed path rather than
# /run/user/$(id -u) because the UID differs between the rootful `dev` path and
# the rootless `--user 0:0` path, and only a fixed value can live in image ENV.
# MOZ_ENABLE_WAYLAND makes Camoufox a native Wayland client.
ENV WAYLAND_DISPLAY=wayland-0 \
    XDG_RUNTIME_DIR=/tmp/xdg \
    MOZ_ENABLE_WAYLAND=1

WORKDIR /work
CMD ["bash"]
