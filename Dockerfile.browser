# syntax=docker/dockerfile:1
#
# Reusable browser layer: agentic-dev-base + KasmVNC (web-native remote view) +
# Camoufox (stealth Firefox, driven by Playwright). Sits BETWEEN the base and the
# agent images so any agent can be re-based onto it to drive & remotely watch a
# browser. Build order:
#   docker build -t agentic-dev-base:latest .
#   docker build -f Dockerfile.browser \
#     --build-arg UID="$(id -u)" --build-arg GID="$(id -g)" \
#     -t agentic-browser-base:latest .
#
# Remote view: a `with-vnc`-wrapped entrypoint starts KasmVNC on :1 and serves it
# over HTTPS (self-signed) on VNC_PORT (default 8444). Camoufox runs non-headless
# on that display, so you watch the exact browser the agent controls. KasmVNC's
# adaptive WebP/JPEG encoding keeps bandwidth low without a WebRTC/GPU stack.
FROM agentic-dev-base:latest

ARG UID=1000
ARG GID=1000

# KasmVNC has no Debian-trixie build; the kali-rolling package tracks Debian
# testing (trixie's libc/toolchain), so it is the compatible choice. Pin the
# version; override with --build-arg KASMVNC_VERSION=X.Y.Z.
ARG KASMVNC_VERSION=1.3.4
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

# --- KasmVNC + minimal X stack + Firefox/Camoufox runtime libs, one layer ---
# t64 suffixes (libasound2t64, libgtk-3-0t64) are the Debian trixie time64 names.
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
        amd64) arch=amd64 ;; \
        arm64) arch=arm64 ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        openbox \
        ssl-cert \
        xauth x11-xserver-utils \
        xfonts-base \
        dbus-x11 \
        libgtk-3-0t64 libx11-xcb1 libasound2t64 libdbus-glib-1-2 \
        libgdk-pixbuf-2.0-0 libpangocairo-1.0-0 libxcomposite1 libxdamage1 \
        libxfixes3 libxrandr2 libxkbcommon0 libatk1.0-0t64 libatk-bridge2.0-0t64 \
        libcups2t64 libnss3 libxss1 \
        fonts-liberation fonts-noto-core; \
    curl -fsSL -o /tmp/kasmvnc.deb \
        "https://github.com/kasmtech/KasmVNC/releases/download/v${KASMVNC_VERSION}/kasmvncserver_kali-rolling_${KASMVNC_VERSION}_${arch}.deb"; \
    apt-get install -y --no-install-recommends /tmp/kasmvnc.deb; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /usr/share/doc/* /usr/share/man/* /tmp/*; \
    command -v vncserver; command -v kasmvncpasswd

# --- Camoufox in its own venv, launcher symlinked onto PATH ---
# uv (from the base) fetches Python 3.11. Kept out of any runtime-mounted dir.
# Playwright is pinned: camoufox 0.4.11's bundled Firefox speaks an older Juggler
# protocol, and playwright > 1.55 sends a setDefaultViewport shape (isMobile) it
# rejects. 1.55.0 is the newest confirmed-compatible release.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
RUN set -eux; \
    uv venv /opt/camoufox/.venv --python 3.11; \
    VIRTUAL_ENV=/opt/camoufox/.venv uv pip install --no-cache "camoufox[geoip]" "playwright==1.55.0"; \
    ln -s /opt/camoufox/.venv/bin/camoufox /usr/local/bin/camoufox; \
    chmod -R a+rX /opt/uv/python /opt/camoufox; \
    rm -rf /root/.cache /tmp/*

# Non-root user (UID/GID match the host owner of mounted files). Created HERE so
# every agent re-based on this layer inherits it — agent Dockerfiles no longer
# create their own.
RUN set -eux; \
    groupadd -g "${GID}" dev 2>/dev/null || true; \
    useradd -m -u "${UID}" -g "${GID}" -s /bin/bash dev

# Download the Camoufox browser + GeoIP DB, baked into the image. Run as root
# (the GeoIP mmdb writes into the root-owned venv site-packages) but with HOME
# set to dev's home so the ~700MB browser lands in /home/dev/.cache/camoufox;
# then hand that cache to dev so the runtime user can read it.
RUN HOME=/home/dev camoufox fetch
RUN chown -R "${UID}:${GID}" /home/dev/.cache

# KasmVNC serves HTTPS from the snakeoil key (owned root:ssl-cert, group-
# readable); dev must be in ssl-cert to read it, else the VNC server can't start.
RUN usermod -aG ssl-cert dev

# Helper scripts last, so tweaking them doesn't invalidate the ~700MB camoufox
# fetch layer above. with-vnc (entrypoint wrapper), camoufox-open (launcher),
# camoufox-py (venv python).
COPY browser/with-vnc browser/camoufox-open browser/camoufox-py /usr/local/bin/
RUN chmod 0755 /usr/local/bin/with-vnc /usr/local/bin/camoufox-open /usr/local/bin/camoufox-py

# Stays root so child agent images can install their own packages. Every shell
# gets DISPLAY=:1 so `camoufox-open` / Playwright target the KasmVNC display even
# under `docker exec` (which does not inherit the entrypoint's environment).
ENV DISPLAY=:1

WORKDIR /work
CMD ["bash"]
